# all optional; copy to studio/.env on the server
RPC_URLS=https://rpc.mainnet.chain.robinhood.com   # a private RPC first (comma-separated) keeps 429s away
STUDIO_KEY=                 # /studio key (generated into data/burn/secrets.json when empty)
BURN_SECRET=                # encrypts the buyback wallet key at rest (generated when empty)
BURN_MAX_USD=100            # most dollars one buyback may spend
BURN_DAY_USD=300            # most dollars all buybacks may spend in 24 hours
